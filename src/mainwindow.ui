  <property name="styleSheet">
   <string notr="true">/* ==================== СВЕТЛАЯ ПРОФЕССИОНАЛЬНАЯ ТЕМА ==================== */

/* Основное окно */
QMainWindow {
    background-color: #f4f6f9;
}

/* Группы */
QGroupBox {
    font-weight: 600;
    border: 1px solid #e2e6ea;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: #ffffff;
    color: #1a2634;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #5b6f82;
    font-weight: 500;
}

/* Кнопки */
QPushButton {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #f0f2f5;
    border-color: #b0b7bf;
}

QPushButton:pressed {
    background-color: #e4e7eb;
}

/* Поля ввода */
QLineEdit {
    background-color: #ffffff;
    color: #1a2634;
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #cbd5e1;
}

QLineEdit:focus {
    border-color: #6c8fb0;
    outline: none;
}

/* Вкладки */
QTabWidget::pane {
    border: 1px solid #e2e6ea;
    border-radius: 8px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f8f9fc;
    color: #5b6f82;
    padding: 8px 24px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2c3e50;
    border-bottom: 2px solid #5a7d9a;
}

QTabBar::tab:hover:!selected {
    background-color: #eef2f6;
    color: #2c3e50;
}

/* Радиокнопки и чекбоксы */
QRadioButton, QCheckBox {
    spacing: 8px;
    color: #2c3e50;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QRadioButton::indicator:unchecked, QCheckBox::indicator:unchecked {
    background-color: #ffffff;
    border: 1px solid #b0b7bf;
    border-radius: 4px;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #5a7d9a;
    border: 1px solid #5a7d9a;
    border-radius: 4px;
}

/* Выпадающие списки */
QComboBox {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #b0b7bf;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #5b6f82;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d5db;
    selection-background-color: #eef2f6;
    selection-color: #2c3e50;
}

/* Спинбоксы (для размера текста) */
QSpinBox {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
}

QSpinBox:focus {
    border-color: #6c8fb0;
}

/* Виджет выбора шрифта */
QFontComboBox {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 6px 12px;
}

/* Статусбар */
QStatusBar {
    background-color: #f8f9fc;
    color: #6c757d;
    border-top: 1px solid #e2e6ea;
}

/* Специальные кнопки (быстрые команды) */
QPushButton[text^=&quot;📰&quot;],
QPushButton[text^=&quot;☀️&quot;],
QPushButton[text^=&quot;🕐&quot;],
QPushButton[text^=&quot;🏢&quot;],
QPushButton[text^=&quot;⚙️&quot;] {
    background-color: #eef2f6;
    border-color: #cbd5e1;
}

QPushButton[text^=&quot;📰&quot;]:hover,
QPushButton[text^=&quot;☀️&quot;]:hover,
QPushButton[text^=&quot;🕐&quot;]:hover,
QPushButton[text^=&quot;🏢&quot;]:hover,
QPushButton[text^=&quot;⚙️&quot;]:hover {
    background-color: #e2e8f0;
    border-color: #b0b7bf;
}</string>
