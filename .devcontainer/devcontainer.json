{
    "name": "Information Board (Qt5 C++)",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools"
            ]
        }
    },
    "runArgs": [
        "-e", "DISPLAY=${localEnv:DISPLAY",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix",
        "-e", "QT_X11_NO_MITSHM=1"
    ]
}